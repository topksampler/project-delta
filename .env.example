# Object storage
S3_BUCKET=lalith-ai-lab
S3_ENDPOINT_URL=https://s3.YOUR-B2-REGION.backblazeb2.com

# Backblaze B2 S3-compatible credentials
AWS_ACCESS_KEY_ID=YOUR_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_APPLICATION_KEY
AWS_REGION=YOUR_B2_REGION
AWS_DEFAULT_REGION=YOUR_B2_REGION

# Local paths
DATA_DIR=/data
MODEL_DIR=/data/models
DATASET_DIR=/data/datasets
RUNS_DIR=/runs

# Lambda Cloud (https://cloud.lambda.ai/api-keys)
LAMBDA_API_KEY=your_lambda_cloud_api_key
# Optional: override API base URL
# LAMBDA_API_BASE=https://cloud.lambdalabs.com/api/v1

# Git repo cloned on Lambda workers (set to your fork)
LAB_REPO_URL=https://github.com/YOUR_USER/lalith-ai-lab.git
LAB_REPO_BRANCH=main

# Hugging Face (optional, for gated models)
# HF_TOKEN=hf_...
# HUGGINGFACE_HUB_TOKEN=hf_...

# Optional credit baselines for `lab credits balance` (USD totals you started with).
# LAMBDA_CREDITS_USD=2000
# MODAL_CREDITS_USD=2000
